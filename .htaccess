RewriteEngine On

# Canonicalizar host y protocolo en una sola redirección (HTTPS + sin www).
# Antes la regla de HTTPS conservaba el host tal cual (%{HTTP_HOST}) y no había
# ninguna para www, así que https://www.toponuble.cl/ respondía 200: la home
# vivía en dos dominios a la vez. El canonical y el sitemap ya apuntan al
# dominio sin www, así que esa es la forma buena.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://toponuble.cl/$1 [L,R=301]

# La home vive en "/" y en ninguna otra URL.
# Antes: /index.html redirigía a /index, que respondía 200 con canonical hacia
# "/" — una tercera URL para la misma home, que Google reportaba como "página
# alternativa con etiqueta canónica adecuada" en vez de consolidarla.
RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirigir URLs con .html a URLs limpias (301)
RewriteCond %{THE_REQUEST} \s(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Servir archivos .html cuando se accede sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

# Caché de estáticos. Antes no se enviaba ninguna cabecera de caché.
#
# Ojo con la distinción: el deploy es por FTP y NO renombra los archivos, así
# que nada acá lleva huella en el nombre. Las imágenes y fuentes casi no cambian
# (y cuando cambian, cambia también su nombre), así que aguantan un año. El CSS
# y el JS sí cambian en cada deploy conservando el nombre: con un año de caché,
# quien ya hubiera visitado el sitio se quedaba con el JS viejo y no vería
# ningún cambio. Van con revalidación: el navegador pregunta y recibe un 304 si
# no cambió, que cuesta casi lo mismo que no preguntar. Mismo bloque que
# arriagadaconsultores.cl y laspilcas.cl.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2|JPG)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
